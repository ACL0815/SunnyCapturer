<Window x:Class="KairosCapture.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Kairos Capture · Einstellungen" Width="560" Height="790" MinWidth="500" MinHeight="550" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize" Background="#13151E">
 <Window.Resources>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="Track" Width="30" Height="18" CornerRadius="9" Background="#383443" BorderBrush="{StaticResource GlassStroke}" BorderThickness="1" HorizontalAlignment="Left">
      <Ellipse x:Name="Thumb" Width="12" Height="12" Fill="#E5DEEF" HorizontalAlignment="Left" Margin="2,0"/>
     </Border>
     <ContentPresenter Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#7D4BE3"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#B097E9"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <ScrollViewer TextElement.Foreground="{StaticResource TextBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="22,18,22,22">
  <Grid Margin="4,0,4,17"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Kairos Capture" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Dein Ausschnitt. Dein Arbeitsfluss." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
   <Border Grid.Column="1" Style="{StaticResource GlassPanel}" Padding="10,6" VerticalAlignment="Center"><TextBlock Text="Einstellungen" FontSize="11" Foreground="{StaticResource LavenderBrush}"/></Border>
  </Grid>
  <Border Style="{StaticResource GlassPanel}" Padding="16" Margin="0,0,0,12"><StackPanel>
   <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Path Data="{StaticResource Glyph.Capture}" Style="{StaticResource GlassIcon}" Stroke="{StaticResource LavenderBrush}"/><TextBlock Text="Aufnahme" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0"/></StackPanel>
   <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="Tastenkürzel" VerticalAlignment="Center"/><TextBox x:Name="HotkeyBox" Grid.Column="1" IsReadOnly="True" Padding="10,7" TextAlignment="Center" PreviewKeyDown="Hotkey_KeyDown" ToolTip="Anklicken und Kombination drücken · Strg, Alt oder Win + Buchstabe/Zahl/F-Taste"/></Grid>
   <TextBlock Text="Speicherordner" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
   <Grid Margin="0,5,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="FolderText" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    <Button Grid.Column="1" Content="Ändern…" Click="Folder_Click" Style="{StaticResource SmallButton}" Margin="8,0,4,0"/>
    <Button Grid.Column="2" Click="OpenFolder_Click" Style="{StaticResource GlassIconButton}" ToolTip="Speicherordner öffnen"><Path Data="{StaticResource Glyph.Folder}" Style="{StaticResource GlassIcon}"/></Button>
   </Grid>
   <CheckBox Foreground="{StaticResource TextBrush}" x:Name="AskSave" Content="Ohne Nachfrage direkt im Ordner speichern" Margin="0,4" Click="Settings_Click"/>
   <CheckBox Foreground="{StaticResource TextBrush}" x:Name="SaveCopy" Content="Beim Kopieren zusätzlich speichern" Margin="0,4" Click="Settings_Click"/>
  </StackPanel></Border>
  <Border Style="{StaticResource GlassPanel}" Padding="16" Margin="0,0,0,12"><StackPanel>
   <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Path Data="{StaticResource Glyph.Ocr}" Style="{StaticResource GlassIcon}" Stroke="{StaticResource LavenderBrush}"/><TextBlock Text="Texterkennung" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0"/><TextBlock Text="OpenAI" Foreground="{StaticResource MutedBrush}" Margin="8,3,0,0"/></StackPanel>
   <TextBlock x:Name="AccountStatus" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
   <ComboBox x:Name="AccountPicker" DisplayMemberPath="Label" SelectionChanged="Account_Changed" Margin="0,0,0,8" ToolTip="ChatGPT-Konto wählen"/>
   <WrapPanel Margin="0,0,0,10">
    <Button x:Name="LoginButton" Content="Weiter mit ChatGPT" Style="{StaticResource SmallButton}" Click="Login_Click" Margin="0,0,6,0"/>
    <Button x:Name="AddAccountButton" Content="Konto hinzufügen" Style="{StaticResource SmallButton}" Click="AddAccount_Click" Margin="0,0,6,0"/>
    <Button x:Name="SignOutButton" Content="Abmelden" Style="{StaticResource SmallButton}" Click="SignOut_Click"/>
    <Button x:Name="CancelLoginButton" Content="Abbrechen" Visibility="Collapsed" Style="{StaticResource SmallButton}" Click="CancelLogin_Click" Margin="6,0,0,0"/>
   </WrapPanel>
   <Button x:Name="ResetSessionButton" Content="Gespeicherte Anmeldung zurücksetzen" Visibility="Collapsed" HorizontalAlignment="Left"
    Style="{StaticResource SmallButton}" Click="ResetSession_Click" Margin="0,0,0,10"
    ToolTip="Verschiebt die gespeicherten Sitzungsdateien in einen Sicherungsordner. Danach können Sie sich neu anmelden."/>
   <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ComboBox x:Name="ModelPicker" DisplayMemberPath="DisplayName" SelectionChanged="Model_Changed" ToolTip="Modell für die Texterkennung"/>
    <Button x:Name="RefreshButton" Grid.Column="1" Content="Aktualisieren" Style="{StaticResource SmallButton}" Click="RefreshModels_Click" Margin="8,0,0,0"/>
   </Grid>
   <CheckBox Foreground="{StaticResource TextBrush}" x:Name="AutoCopy" Content="Erkannten Text automatisch kopieren" Margin="0,4" Click="Settings_Click"/>
  </StackPanel></Border>
  <Border Style="{StaticResource GlassPanel}" Padding="16"><StackPanel>
   <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Path Data="{StaticResource Glyph.Settings}" Style="{StaticResource GlassIcon}" Stroke="{StaticResource LavenderBrush}"/><TextBlock Text="System" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0"/></StackPanel>
   <CheckBox Foreground="{StaticResource TextBrush}" x:Name="StartupCheck" Content="Mit Windows starten" Click="Startup_Click" Margin="0,0,0,10"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Version 0.4.0" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Protokollordner öffnen" Click="Logs_Click" Style="{StaticResource SmallButton}"/></Grid>
  </StackPanel></Border>
  <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="6,10,6,0" Foreground="{StaticResource LavenderBrush}" FontSize="12"/>
 </StackPanel></ScrollViewer>
</Window>
