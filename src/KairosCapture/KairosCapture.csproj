<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>KairosCapture</RootNamespace>
    <AssemblyName>KairosCapture</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>KairosCapture.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Company>Kairos Capture</Company>
    <Description>Screenshot-Werkbank für Windows</Description>
    <Deterministic>true</Deterministic>
    <!-- WPF owns PerMonitorV2 in the manifest; WinForms is used only for tray and clipboard. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
  </ItemGroup>
</Project>
