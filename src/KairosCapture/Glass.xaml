<!-- Shared glass resources for app windows, overlay controls and the icon renderer.
     GlassFill / GlassStroke / GlassHighlight: brushes for translucent surfaces.
     GlassPanel (Border): floating glass surface. GlassIcon (Path): Data = {StaticResource Glyph.X}, 24x24 box, Stroke = inherited Foreground.
     GlassIconButton (Button): round/squircle icon button, Content is a Path with GlassIcon style.
     GlassToolToggle (ToggleButton, also used for RadioButton): like GlassIconButton with a checked state.
     GlassSwatch (RadioButton): colour dot, Background = colour.
     Caller blurs the backdrop. No BlurEffect, animation clock or per-button shadow here. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#E02A2538" Offset="0" /><GradientStop Color="#DC181923" Offset="0.45" /><GradientStop Color="#EB10151D" Offset="1" /></LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassStroke" StartPoint="0,0" EndPoint="0.28,1"><GradientStop Color="#9CE9DDFF" Offset="0" /><GradientStop Color="#3CB6A3D8" Offset="0.28" /><GradientStop Color="#1CFFFFFF" Offset="0.65" /><GradientStop Color="#4DCEC1E8" Offset="1" /></LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassHighlight" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#20FFFFFF" Offset="0" /><GradientStop Color="#06FFFFFF" Offset="0.38" /><GradientStop Color="#00FFFFFF" Offset="0.6" /><GradientStop Color="#06B097E9" Offset="1" /></LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassSelectedFill" StartPoint="0,0" EndPoint="0.25,1"><GradientStop Color="#F15B3796" Offset="0" /><GradientStop Color="#E8431B96" Offset="0.55" /><GradientStop Color="#EF30175B" Offset="1" /></LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassPrimaryFill" StartPoint="0,0" EndPoint="0.2,1"><GradientStop Color="#F757289F" Offset="0" /><GradientStop Color="#F44D229A" Offset="0.5" /><GradientStop Color="#FA431B96" Offset="1" /></LinearGradientBrush>
  <Style x:Key="GlassFocus" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Border Margin="-4" CornerRadius="16" BorderBrush="#B097E9" BorderThickness="2" IsHitTestVisible="False" /></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="GlassPanel" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource GlassFill}" /><Setter Property="BorderBrush" Value="{StaticResource GlassStroke}" />
    <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="22" /><Setter Property="Padding" Value="10" />
    <Setter Property="TextElement.Foreground" Value="#F4F2FA" />
    <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#04050B" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.28" RenderingBias="Performance" /></Setter.Value></Setter>
  </Style>
  <Style x:Key="GlassIcon" TargetType="Path">
    <Setter Property="Width" Value="20" /><Setter Property="Height" Value="20" /><Setter Property="Stretch" Value="Uniform" /><Setter Property="Fill" Value="{x:Null}" />
    <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Stroke" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
    <Setter Property="StrokeThickness" Value="1.75" /><Setter Property="StrokeStartLineCap" Value="Round" /><Setter Property="StrokeEndLineCap" Value="Round" /><Setter Property="StrokeLineJoin" Value="Round" />
  </Style>
  <!-- ButtonBase template and style serve Button, ToggleButton and RadioButton.
       Hover overlays preserve the checked colour; only the surface moves. -->
  <ControlTemplate x:Key="GlassButtonTemplate" TargetType="ButtonBase">
    <Grid x:Name="Surface" RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
      <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13" />
      <Border Background="{StaticResource GlassHighlight}" CornerRadius="12" Margin="1" IsHitTestVisible="False" />
      <Border x:Name="HoverLight" Background="#1CFFFFFF" CornerRadius="12" Margin="1" Opacity="0" IsHitTestVisible="False" />
      <Border x:Name="PressShade" Background="#35080B14" CornerRadius="12" Margin="1" Opacity="0" IsHitTestVisible="False" />
      <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HoverLight" Property="Opacity" Value="1" /><Setter TargetName="Surface" Property="RenderTransform"><Setter.Value><TranslateTransform Y="-1" /></Setter.Value></Setter></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="HoverLight" Property="Opacity" Value="0" /><Setter TargetName="PressShade" Property="Opacity" Value="1" /><Setter TargetName="Surface" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1" /></Setter.Value></Setter></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /><Setter TargetName="HoverLight" Property="Opacity" Value="0" /><Setter TargetName="Surface" Property="RenderTransform"><Setter.Value><TranslateTransform Y="0" /></Setter.Value></Setter></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="GlassButtonBase" TargetType="ButtonBase">
    <Setter Property="Width" Value="36" /><Setter Property="Height" Value="36" /><Setter Property="MinHeight" Value="0" /><Setter Property="Padding" Value="7" />
    <Setter Property="Background" Value="{StaticResource GlassFill}" /><Setter Property="Foreground" Value="#F4F2FA" /><Setter Property="BorderBrush" Value="{StaticResource GlassStroke}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource GlassFocus}" /><Setter Property="Template" Value="{StaticResource GlassButtonTemplate}" />
  </Style>
  <Style x:Key="GlassIconButton" TargetType="Button" BasedOn="{StaticResource GlassButtonBase}" />
  <Style x:Key="GlassConfirmButton" TargetType="Button" BasedOn="{StaticResource GlassIconButton}">
    <Setter Property="Background" Value="{StaticResource GlassSelectedFill}" /><Setter Property="Foreground" Value="#D8C8FA" /><Setter Property="BorderBrush" Value="#85B097E9" />
  </Style>
  <Style x:Key="GlassToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource GlassButtonBase}">
    <Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="{StaticResource GlassSelectedFill}" /><Setter Property="BorderBrush" Value="#B890C4FA" /><Setter Property="Foreground" Value="#D8C8FA" /></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="GlassPrimaryButton" TargetType="Button" BasedOn="{StaticResource GlassButtonBase}">
    <Setter Property="Width" Value="Auto" /><Setter Property="Height" Value="40" /><Setter Property="Padding" Value="16,8" /><Setter Property="Background" Value="{StaticResource GlassPrimaryFill}" /><Setter Property="BorderBrush" Value="#A0D2B8FF" /><Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="GlassSwatch" TargetType="RadioButton">
    <Setter Property="Width" Value="28" /><Setter Property="Height" Value="28" /><Setter Property="Background" Value="#D3B576" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{StaticResource GlassFocus}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Grid x:Name="Dot" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform><TranslateTransform /></Grid.RenderTransform>
        <Ellipse x:Name="Ring" Fill="#60090E13" Stroke="{StaticResource GlassStroke}" StrokeThickness="1" />
        <Ellipse Margin="4" Fill="{TemplateBinding Background}" Stroke="#50FFFFFF" StrokeThickness="1" />
        <Ellipse Margin="5" Fill="{StaticResource GlassHighlight}" IsHitTestVisible="False" />
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="#D4E9DDFF" /><Setter TargetName="Dot" Property="RenderTransform"><Setter.Value><TranslateTransform Y="-1" /></Setter.Value></Setter></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="White" /><Setter TargetName="Ring" Property="StrokeThickness" Value="2" /></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Dot" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1" /></Setter.Value></Setter></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /><Setter TargetName="Dot" Property="RenderTransform"><Setter.Value><TranslateTransform Y="0" /></Setter.Value></Setter></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="GlassDivider" TargetType="Border"><Setter Property="Height" Value="1" /><Setter Property="Margin" Value="6,8" /><Setter Property="Background" Value="#32CBB7EC" /></Style>
  <Style x:Key="GlassPinContextMenu" TargetType="ContextMenu">
    <Setter Property="Foreground" Value="#F4F2FA" /><Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="FontSize" Value="13" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
      <Border Style="{StaticResource GlassPanel}" CornerRadius="14" Padding="5" Margin="12"><StackPanel IsItemsHost="True" /></Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="GlassPinMenuItem" TargetType="MenuItem">
    <Setter Property="Foreground" Value="#F4F2FA" /><Setter Property="Padding" Value="9,7" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
      <Border x:Name="Surface" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" /><ContentPresenter Grid.Column="1" ContentSource="Header" Margin="6,0,14,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
        </Grid>
      </Border>
      <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="#555B3796" /></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="GlassChip" TargetType="Border"><Setter Property="Background" Value="{StaticResource GlassFill}" /><Setter Property="BorderBrush" Value="{StaticResource GlassStroke}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="9,4" /><Setter Property="TextElement.Foreground" Value="#DDD3F1" /></Style>
</ResourceDictionary>
