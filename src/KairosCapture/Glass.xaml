<!-- CONTRACT (Lead): keys are fixed; visual content is owned by the icon/glass writer.
     GlassFill / GlassStroke / GlassHighlight: brushes for translucent surfaces.
     GlassPanel (Border): floating glass surface. GlassIcon (Path): Data = {StaticResource Glyph.X}, 24x24 box, Stroke = inherited Foreground.
     GlassIconButton (Button): round/squircle icon button, Content is a Path with GlassIcon style.
     GlassToolToggle (ToggleButton, also used for RadioButton): like GlassIconButton with a checked state.
     GlassSwatch (RadioButton): colour dot, Background = colour. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="GlassFill" Color="#B3161A24" />
  <SolidColorBrush x:Key="GlassStroke" Color="#40FFFFFF" />
  <SolidColorBrush x:Key="GlassHighlight" Color="#26FFFFFF" />
  <Style x:Key="GlassPanel" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource GlassFill}" /><Setter Property="BorderBrush" Value="{StaticResource GlassStroke}" />
    <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="22" /><Setter Property="Padding" Value="8" />
  </Style>
  <Style x:Key="GlassIcon" TargetType="Path">
    <Setter Property="Width" Value="18" /><Setter Property="Height" Value="18" /><Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
    <Setter Property="StrokeThickness" Value="1.75" /><Setter Property="StrokeStartLineCap" Value="Round" /><Setter Property="StrokeEndLineCap" Value="Round" /><Setter Property="StrokeLineJoin" Value="Round" />
  </Style>
  <Style x:Key="GlassIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
    <Setter Property="Foreground" Value="#F4F2FA" />
  </Style>
  <Style x:Key="GlassToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToolButton}" />
  <Style x:Key="GlassSwatch" TargetType="RadioButton" BasedOn="{StaticResource Swatch}" />
</ResourceDictionary>
